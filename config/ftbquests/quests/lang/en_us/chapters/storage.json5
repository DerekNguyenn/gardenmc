{
  "quest.328555BD27C57680.title": "Backpacks!",
  "quest.2646BF2E36641D41.quest_desc": [
    "You can put em' on Minecarts too!",
  ],
  "quest.328555BD27C57680.quest_desc": [
    "&lSophisticated Backpacks&r is the backpack mod for BMC6. You can craft multiple backpacks, forge them into higher tiers, and craft additional upgrade modules!",
    "",
    "On top of being great backpacks, they also function as really great utility items! Check out some of the upgrade modules to learn more!",
  ],
  "quest.490BDB2575285903.quest_desc": [
    "&lSophisticated Storage&r provides upgraded chests, allowing you to store many more items at once, and keep them all sorted!",
    "",
    "You can forge them into higher tiers with Tier Upgrades, which add more slots, or you can deepen the size of the slots with Stack Upgrades.",
  ],
  "quest.490BDB2575285903.title": "Chests!",
  "quest.3611269FA14846B6.quest_desc": [
    "You can link up multiple barrels into one inventory with the Storage Controller!",
    "",
    "You won't be able to open the entire thing as one inventory, but you can pipe items in/out all at once!",
  ],
}